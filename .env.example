# Copy to .env and fill in. Never commit or share .env.

# Model. Either an OpenRouter key (used automatically when set; runs Gemini via openrouter.ai)...
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=google/gemini-3.8-flash
# ...or a free Google key from https://aistudio.google.com -> Get API key
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-latest

# Contact finding (Step 4): https://hunter.io -> API
HUNTER_API_KEY=

# Sending (Step 7). Resend is tried first when set (resend.com, free tier). The sandbox sender
# below only delivers to the email on your Resend account, so SEND_TO must be that address.
RESEND_API_KEY=
# RESEND_FROM=Sprinto Outreach Drafts <onboarding@resend.dev>
SEND_TO=
# Gmail fallback: your Gmail + an app password (Google Account -> Security -> App passwords)
GMAIL_ADDRESS=you@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

SENDER_NAME=Aryan
SENDER_TITLE=Growth, Sprinto

# To use Claude later instead: LLM_PROVIDER=claude, ANTHROPIC_API_KEY=..., pip install anthropic
# ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5-5
