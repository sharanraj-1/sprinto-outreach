# Copy to .env and fill in. Never commit or share .env.

# Model: free key from https://aistudio.google.com -> Get API key
LLM_PROVIDER=gemini
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-latest

# Contact finding (Step 4): https://hunter.io -> API
HUNTER_API_KEY=

# Sending (Step 7): your Gmail + an app password (Google Account -> Security -> App passwords)
GMAIL_ADDRESS=you@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

SENDER_NAME=Aryan
SENDER_TITLE=Growth, Sprinto

# To use Claude later instead: LLM_PROVIDER=claude, ANTHROPIC_API_KEY=..., pip install anthropic
# ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5-5
